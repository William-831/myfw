# syntax=docker/dockerfile:1
# Multi-stage build for the MYFW Controller.
# Produces a small static image. See docs/deployment.md § 4.

# ---- web build stage ----
FROM node:20-alpine AS web-build
WORKDIR /web
COPY web/package.json web/package-lock.json* ./
RUN npm ci
COPY web/ .
RUN npm run build

# ---- go build stage ----
FROM golang:1.26 AS build
WORKDIR /src

COPY go.mod go.sum* ./
RUN go mod download || true

COPY . .
ARG VERSION=dev
RUN CGO_ENABLED=0 go build -trimpath \
    -ldflags="-s -w -X main.version=${VERSION}" \
    -o /out/myfw-controller ./cmd/controller

# ---- runtime stage ----
# 使用 Alpine 作为运行时镜像（distroless 在 docker build 中可能不可用）
FROM alpine:3.21

RUN apk --no-cache add ca-certificates tzdata
COPY --from=build /out/myfw-controller /usr/local/bin/myfw-controller
COPY --from=web-build /web/dist /var/www/myfw

EXPOSE 8080 9090
ENTRYPOINT ["/usr/local/bin/myfw-controller"]
CMD ["--config", "/etc/myfw/config.yaml"]
