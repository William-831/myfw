# MYFW Controller 环境变量 - 复制为 .env 填入真实值
# .env 已 git-ignored,本文件作为模板提交

# 数据库(MySQL 或 OceanBase 直连,均兼容 MySQL 协议)
# MySQL 示例:    tcp(10.0.0.5:3306)/myfw
# OceanBase 直连: tcp(10.0.0.5:2881)/myfw  (2881=直连 OB Server, 2883=经 ODP 代理)
MYFW_DB_DRIVER=mysql
MYFW_DB_DSN=myfw_user:REPLACE_ME@tcp(ob.internal.example.com:2881)/myfw?charset=utf8mb4&parseTime=true&loc=Local
# 自动建库(默认 true); DBA 严格环境可设 false 关闭
# MYFW_DB_AUTOCREATE=false

# HMAC 密钥(生产必须设置,否则每次重启随机生成,所有 Agent session 失效需重连)
# 生成: openssl rand -hex 32
MYFW_HMAC_SECRET=REPLACE_ME_WITH_64_HEX_CHARS

# 连接池覆盖(可选,默认见 controller.prod.example.yaml)
# MYFW_DB_MAX_OPEN_CONNS=50
# MYFW_DB_MAX_IDLE_CONNS=10

# Controller server 证书 SAN:Agent 连接 Controller 的地址(与 Web 控制台地址一致)
# 格式:IP:1.2.3.4 或 DNS:myfw.example.com,多个用逗号分隔,如 IP:10.0.0.5,DNS:myfw.example.com
# 首次 up 由入口脚本以此 SAN 签发 server 证书并持久化到 deploy/docker/dev-ca/;
# 不配置也能启动(无 SAN,后续接入 Agent 前需补配:注释去掉并填地址后,
# 删除 deploy/docker/dev-ca/server.crt 与 server.key,重启容器重新签发,CA 不受影响)
# MYFW_SAN=IP:192.168.80.249
