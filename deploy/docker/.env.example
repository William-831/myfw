# MYFW Controller environment — copy to .env and fill in real values.
# .env is git-ignored; this .env.example is committed as a template.
# See docs/deployment.md § 4.3.

# Database (production: external OceanBase via MySQL protocol)
MYFW_DB_DRIVER=mysql
MYFW_DB_DSN=myfw_user:REPLACE_ME@tcp(ob.internal.example.com:2881)/myfw?charset=utf8mb4&parseTime=true&loc=Local

# Optional pool overrides
# MYFW_DB_MAX_OPEN_CONNS=50
# MYFW_DB_MAX_IDLE_CONNS=10
